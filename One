public class CustomRemoteWebDriver extends RemoteWebDriver {

    public CustomRemoteWebDriver(CommandExecutor executor, Capabilities capabilities) {
        super(executor, capabilities);
    }

    // Make protected setSessionId public
    public void setSessionIdPublic(String sessionId) {
        super.setSessionId(sessionId);
    }
}







