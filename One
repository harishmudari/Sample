package com.resuable;

import java.io.*;
import java.util.Properties;

import java.io.*;
import java.util.Properties;

public class SessionManager {
    private static final String FILE_PATH = "session.properties";

    // Save session details
    public static void saveSession(String executorUrl, String sessionId) {
        try (FileOutputStream fos = new FileOutputStream(FILE_PATH)) {
            Properties props = new Properties();
            props.setProperty("executorUrl", executorUrl);
            props.setProperty("sessionId", sessionId);
            props.store(fos, "Selenium Session Details");
            System.out.println("Session saved: " + executorUrl + " | " + sessionId);
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // Load session details
    public static Properties loadSession() {
        Properties props = new Properties();
        try (FileInputStream fis = new FileInputStream(FILE_PATH)) {
            props.load(fis);
            return props;
        } catch (Exception e) {
            System.out.println("No previous session found.");
            return null;
        }
    }

    // Clear session (use if browser was closed)
    public static void clearSession() {
        File file = new File(FILE_PATH);
        if (file.exists()) {
            file.delete();
         System.out.println("SessionManager.clearSession(): deleted");
        }
    }
}
